---
import GalleryPage from '../layouts/GalleryPage.astro';
import type { ImageMetadata } from 'astro';  // ← required
import { globToPhotos } from '../utils/photos';

const photos = globToPhotos(
  import.meta.glob<{ default: ImageMetadata }>(
    '../assets/images/stylistic/*.{jpg,jpeg,JPG,png,PNG,webp}',
    { eager: true }
  )
);
photos.sort((a, b) => b.alt.localeCompare(a.alt));
---

<GalleryPage
  title="Stylistic & Artistic — Ari Weber Photography"
  description="Stylistic and artistic photography by Ari Weber — moons, guitars, long exposures."
  eyebrow="Collection 04"
  heading="Stylistic & Artistic"
  photos={photos}
/>
