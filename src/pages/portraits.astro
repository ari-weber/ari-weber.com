---
import GalleryPage from '../layouts/GalleryPage.astro';
import type { ImageMetadata } from 'astro';  // ← required
import { globToPhotos } from '../utils/photos';

const photos = globToPhotos(
  import.meta.glob<{ default: ImageMetadata }>(
    '../assets/images/portraits/*.{jpg,jpeg,JPG,png,PNG,webp}',
    { eager: true }
  )
);
photos.sort((a, b) => b.alt.localeCompare(a.alt));
---

<GalleryPage
  title="Portraits — Ari Weber Photography"
  description="Portrait photography by Ari Weber — candid, lifestyle, and studio portraits."
  eyebrow="Collection 02"
  heading="Portrait"
  photos={photos}
/>
