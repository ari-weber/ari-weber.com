---
// landscapes.astro
import GalleryPage from '../layouts/GalleryPage.astro';
import type { ImageMetadata } from 'astro';  // ← required
import { globToPhotos } from '../utils/photos';

const photos = globToPhotos(
  import.meta.glob<{ default: ImageMetadata }>(
    '../assets/images/landscapes-architectural/*.{jpg,jpeg,JPG,png,PNG,webp}',
    { eager: true }
  )
);
photos.sort((a, b) => b.alt.localeCompare(a.alt));
---

<GalleryPage
  title="Landscapes & Architectural — Ari Weber Photography"
  description="Landscape and architectural photography..."
  eyebrow="Collection 01"
  heading="Landscapes & Architectural"
  photos={photos}
/>